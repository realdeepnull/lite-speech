{
  "name": "@lite-speech/engine-onnx",
  "version": "0.0.0",
  "description": "Local text-to-speech engine for lite-speech, powered by Transformers.js and ONNX Runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./worker": {
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "engine entry (model runtime not included)",
      "path": "dist/index.js",
      "limit": "30 kB",
      "gzip": true
    }
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "transformers",
    "onnx",
    "webworker",
    "browser",
    "local",
    "offline"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realdeepnull/lite-speech.git",
    "directory": "packages/engine-onnx"
  },
  "homepage": "https://github.com/realdeepnull/lite-speech#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@lite-speech/core": "^0.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "@lite-speech/core": "0.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.4",
    "vitest": "^5.0.5"
  }
}
